{
  "expo": {
    "name": "Comly",
    "slug": "comly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "comly",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.comly.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Comly uses your photo library so you can choose a profile photo.",
        "NSCameraUsageDescription": "Comly uses your camera only to take a profile photo, and only when you choose to.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "com.comly.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Comly doesn't use Face ID. Your sign-in is kept in your device's secure keychain."
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "comly",
          "project": "comly-app",
          "url": "https://sentry.io/"
        }
      ],
      "./plugins/withPodsMinimumDeploymentTarget",
      "./plugins/withSceneLifecycle"
    ],
    "extra": {
      "useMocks": false,
      "eas": {
        "projectId": "c03206d8-6445-49b9-a5cc-affab4523ce1"
      }
    },
    "owner": "raphy-muthus-team"
  }
}
