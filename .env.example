# ─────────────────────────────────────────────────────────────────────────────
# Comly environment variables
#
# Copy this file to `.env` and fill in real values when you're ready to connect
# live services. Until then, leave EXPO_PUBLIC_USE_MOCKS=true and the app runs
# end-to-end on seeded demo data with NO accounts required.
#
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the client bundle.
# Server-only secrets (OpenAI key, service role key) live in Supabase Edge
# Function secrets — NEVER put them in this client .env.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. true = mock mode (no keys needed). false = use real services.
EXPO_PUBLIC_USE_MOCKS=true

# ── Supabase (client) ────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe to ship in the client.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Google Maps (client) ─────────────────────────────────────────────────────
# OPTIONAL. The in-app map preview uses react-native-maps, which needs no key
# in Expo Go (Apple Maps on iOS). A key is only required for Google Maps tiles
# in standalone Android builds. Restrict the key to your bundle id.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── OAuth (server-side, via Supabase dashboard — NOT in this file) ───────────
# Google/Apple sign-in is configured in Supabase → Authentication → Providers:
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   APPLE_CLIENT_ID  / APPLE_CLIENT_SECRET (Services ID + key)
# plus the redirect URL comly://auth-callback. Full steps: DEPLOYMENT.md §OAuth.

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE SECRETS — set these as Supabase Edge Function secrets, not here:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# Listed here only as a checklist:
#   OPENAI_API_KEY               (AI job assistant, safety review, recommendations)
#   SUPABASE_SERVICE_ROLE_KEY    (privileged DB access inside edge functions)
# ─────────────────────────────────────────────────────────────────────────────
